# Server configuration template. For local development use .env.local.example.
# For Vercel use .env.vercel.example. Never put real keys in tracked files.
APP_ENV=production
AUTH_MODE=supabase
HARNESS_PROVIDER=openai
MAX_CONCURRENT_JOBS=20
MODEL_TIMEOUT_SECONDS=35
APP_PUBLIC_URL=https://your-site.example
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
# reasoning_effort=none and max_completion_tokens=1024 are fixed in openai_policy.py.
# BRAIN metadata snapshot for the exact account/Region/Universe/Delay.
# BRAIN_CATALOG_PATH=/absolute/path/to/brain-account-catalog.json
# Set true in production after importing a current scoped catalog.
BRAIN_REQUIRE_SCOPED_CATALOG=false
