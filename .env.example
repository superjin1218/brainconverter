# 직접 발급한 키만 배포 환경의 Secret으로 등록하세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
HARNESS_PROVIDER=openai
APP_ENV=production

# Cloudflare Gateway와 Cloud Run 사이의 요청 서명용 값입니다.
GATEWAY_SHARED_SECRET=

# 쉼표로 구분한 허용 이메일. 비워 두면 Gateway 정책만 사용합니다.
ALLOWED_EMAILS=

# 동시 하네스 작업 수와 외부 모델 timeout(초)
MAX_CONCURRENT_JOBS=2
MODEL_TIMEOUT_SECONDS=40

