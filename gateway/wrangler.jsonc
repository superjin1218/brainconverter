{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brain-alpha-harness-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "send_metrics": false,
  "durable_objects": {"bindings": [{"name": "PILOT", "class_name": "PilotCoordinator"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["PilotCoordinator"]}],
  "vars": {
    "MONTHLY_LIMIT": "50", "DAILY_LIMIT": "20", "GLOBAL_MONTHLY_LIMIT": "1000",
    "MONTHLY_BUDGET_USD": "10", "SERVICE_ENABLED": "true"
  }
}
