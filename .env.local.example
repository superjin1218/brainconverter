# Copy to .env.local for the member site. This file is not used by make dev-mock.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Required for approved-member conversion quota/result storage. Keep Secret private.
SUPABASE_SECRET_KEY=
# Used by make dev-ai and make deploy-openai.
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
HARNESS_PROVIDER=openai
MODEL_TIMEOUT_SECONDS=35
