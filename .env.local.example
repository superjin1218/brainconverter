# Copy to .env.local for the member site. This file is not used by make dev-mock.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Required for approved-member conversion quota/result storage. Keep Secret private.
SUPABASE_SECRET_KEY=
# Use meta for a Meta-issued key, gateway for a Vercel AI Gateway key.
MUSE_API_PROVIDER=meta
# Used by make dev-ai. AI_API_KEY is an alias; never use an OpenAI key here.
META_API_KEY=
# For MUSE_API_PROVIDER=gateway, set AI_GATEWAY_API_KEY instead.
MUSE_MODEL=meta/muse-spark-1.3-contributor
