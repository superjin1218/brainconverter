SUPABASE_PUBLISHABLE_KEY=
# Secrets: enter values directly into the Vercel dashboard; never commit them.
SUPABASE_SECRET_KEY=
META_API_KEY=
# AI_API_KEY is accepted when your existing Vercel secret uses that name.
