AUTH_MODE=supabase
HARNESS_PROVIDER=muse
MUSE_API_PROVIDER=meta
MUSE_MODEL=meta/muse-spark-1.3-contributor
MAX_CONCURRENT_JOBS=20
MODEL_TIMEOUT_SECONDS=35
APP_PUBLIC_URL=https://natural-language-brain-alpha-harness.vercel.app
